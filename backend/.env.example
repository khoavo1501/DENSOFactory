# ====== REQUIRED (fail-fast nếu thiếu) ======
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=$2b$12$replace-with-real-bcrypt-hash

# ====== Database ======
DATABASE_URL=postgresql+psycopg2://iigw:iigw@postgres:5432/iigw
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=replace-with-influx-token
INFLUXDB_ORG=iigw
INFLUXDB_BUCKET=telemetry

# ====== MQTT (read-only) ======
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883

# ====== OPTIONAL (có default hợp lý) ======
# DIAG_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=365
# REVOKED_TOKEN_RETENTION_DAYS=30
# ACCESS_TOKEN_TTL_MIN=15
# REFRESH_TOKEN_TTL_HOURS=8
# CLEANUP_CRON_HOUR=2

# ====== App ======
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
EXPORT_MAX_ROWS=100000
