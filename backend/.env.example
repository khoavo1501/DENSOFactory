# ====== REQUIRED (fail-fast nếu thiếu) ======
# Generate with: scripts/generate-bcrypt-hash.py <password>
# Or: docker compose run --rm backend python -c "from passlib.context import CryptContext; c=CryptContext(schemes=['bcrypt'], deprecated='auto', bcrypt__rounds=12); print(c.hash('admin123'))"
JWT_SECRET=dev-secret-please-change-32bytes-min-xxxxx
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=__REPLACE_WITH_BCRYPT_HASH__

# ====== Database (defaults match docker-compose) ======
DATABASE_URL=postgresql+psycopg2://iigw:iigw@postgres:5432/iigw
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=replace-with-influx-token
INFLUXDB_ORG=iigw
INFLUXDB_BUCKET=telemetry

# ====== MQTT (read-only) ======
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883

# ====== Optional ======
# DIAG_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=365
# REVOKED_TOKEN_RETENTION_DAYS=30
# ACCESS_TOKEN_TTL_MIN=15
# REFRESH_TOKEN_TTL_HOURS=8
# CLEANUP_CRON_HOUR=2

# ====== App ======
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
EXPORT_MAX_ROWS=100000
